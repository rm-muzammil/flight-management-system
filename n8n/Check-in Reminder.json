    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n// NOTE: flights table has no origin_timezone/destination_timezone columns yet.\n// Showing UTC for now. If timezone columns are added later, restore proper\n// per-timezone conversion here instead of toUTCString().\nconst departure = new Date(item.departure_at);\nconst localDeparture = departure.toUTCString();\nreturn { json: { ...item, local_departure_display: localDeparture } };"
      },
      "id": "e968faf5-b894-4a8f-b016-23b508b5d833",
      "name": "Format Departure Time (UTC)",
