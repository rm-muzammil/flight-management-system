    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT b.id AS booking_id, b.passenger_email, b.passenger_name, f.flight_number, f.origin, f.destination, f.departure_at FROM bookings b JOIN flights f ON f.id = b.flight_id WHERE f.departure_at BETWEEN NOW() + INTERVAL '23 hours 30 minutes' AND NOW() + INTERVAL '24 hours 30 minutes' AND b.status = 'confirmed' AND f.status != 'cancelled' AND NOT EXISTS (SELECT 1 FROM notification_log nl WHERE nl.booking_id = b.id AND nl.type = 'checkin_reminder');",
        "options": {}
      },
      "id": "8ea2ef87-33aa-4f94-b240-f579ba4e0a0e",
      "name": "Find Bookings Departing in ~24h",
